@startuml
' Generated from the same paper-trace model as graph.html
top to bottom direction
skinparam backgroundColor #F8FAFC
skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontName Arial
skinparam ArrowColor #64748B
skinparam ArrowThickness 1
skinparam rectangleBorderColor #64748B
skinparam rectangleFontColor #172033
skinparam rectangleFontSize 11
skinparam linetype polyline
hide stereotype
title Agent workflow trace — layered DAG
rectangle "<b>Explain and safely advance an agent task</b>\n<size:9>CONTEXT · Case · execute</size>" as n0_case_DEMO_001 #dbeafe
rectangle "<b>Quickstart paper-trace run</b>\n<size:9>CONTEXT · Run · running</size>" as n1_run_DEMO_001_001 #dbeafe
rectangle "<b>Make evidence, control and execution easy to inspect</b>\n<size:9>CONTEXT · Goal · recorded</size>" as n2_goal_DEMO_001_clarity #dbeafe
rectangle "<b>Use one trace model for PlantUML and interactive HTML</b>\n<size:9>PLAN · Decision · accepted</size>" as n3_decision_DEMO_001_two_views #e0e7ff
rectangle "<b>Inspect the evidence and explicit dependencies</b>\n<size:9>INSPECT · Step · completed</size>" as n4_step_DEMO_001_inspect #ede9fe
rectangle "<b>Select the next safe action from the graph</b>\n<size:9>EXECUTE · Action · running</size>" as n5_action_DEMO_001_select #ffedd5
rectangle "<b>Verify the selected action and its evidence path</b>\n<size:9>VALIDATE · Verification · pending</size>" as n6_verification_DEMO_001_review #dcfce7
n0_case_DEMO_001 -[#CBD5E1]-> n1_run_DEMO_001_001
n1_run_DEMO_001_001 -[#CBD5E1]-> n2_goal_DEMO_001_clarity
n1_run_DEMO_001_001 -[#CBD5E1]-> n3_decision_DEMO_001_two_views
n1_run_DEMO_001_001 -[#CBD5E1]-> n4_step_DEMO_001_inspect
n3_decision_DEMO_001_two_views --> n5_action_DEMO_001_select : implemented_by
n4_step_DEMO_001_inspect --> n5_action_DEMO_001_select : precedes
n5_action_DEMO_001_select --> n6_verification_DEMO_001_review : precedes
legend left
  |= Color |= Workflow phase |
  |<#DBEAFE> | Context |
  |<#E0E7FF> | Plan |
  |<#EDE9FE> | Inspect |
  |<#FFEDD5> | Execute |
  |<#DCFCE7> | Validate |
  |<#FCE7F3> | Claim |
  Static view = forward workflow/dependency DAG
  Evidence/review links = HTML Evidence tab
endlegend
@enduml
